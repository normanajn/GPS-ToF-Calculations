Cell["\<\
Function that converts the angular coordinate (in deg, min, sec) to a decimal \
representation\
\>", "Text",
 CellChangeTimes->{{3.5754848521150637`*^9, 
  3.575484902547011*^9}},ExpressionUUID->"c50a9d7d-2da0-4710-acb2-\
b0387919afb3"],

Cell[BoxData[
 RowBox[{
  RowBox[{"LC", "[", 
   RowBox[{"deg_", ",", " ", "min_", ",", " ", "sec_"}], "]"}], ":=", " ", 
  RowBox[{"N", "[", " ", 
   RowBox[{
    RowBox[{"\[Pi]", "/", "180"}], 
    RowBox[{"(", " ", 
     RowBox[{"deg", " ", "+", " ", 
      RowBox[{
       RowBox[{"(", 
        RowBox[{"min", " ", "+", " ", 
         RowBox[{"(", 
          RowBox[{"sec", "/", "60"}], ")"}]}], ")"}], "/", "60"}]}], ")"}]}], 
   " ", "]"}]}]], "Input",
 CellChangeTimes->{{3.571667598106346*^9, 3.5716677069566793`*^9}, {
  3.571667742647629*^9, 
  3.5716677662849207`*^9}},ExpressionUUID->"b09b882c-4316-48b5-9660-\
a75abde942e2"],

Cell["\<\
Function to convert the latitude, longitude and altitude to the cartisan \
coordinates in a earth centered frame\
\>", "Text",
 CellChangeTimes->{{3.575484911464856*^9, 
  3.575484956340798*^9}},ExpressionUUID->"d367f35e-7da6-4607-9713-\
ef0baa5d2d64"],

Cell[BoxData[
 RowBox[{
  RowBox[{"pcart", "[", 
   RowBox[{"lat_", ",", "longitude_", ",", "alt_"}], "]"}], ":=", " ", 
  RowBox[{"N", "[", 
   RowBox[{"{", " ", 
    RowBox[{
     RowBox[{
      RowBox[{"(", 
       RowBox[{"alt", "+", "REarth"}], ")"}], " ", "*", " ", 
      RowBox[{"Cos", "[", " ", "lat", " ", "]"}], "*", 
      RowBox[{"Sin", "[", "longitude", " ", "]"}]}], ",", 
     RowBox[{
      RowBox[{"(", 
       RowBox[{"alt", "+", "REarth"}], ")"}], " ", 
      RowBox[{"Sin", "[", "lat", "]"}]}], ",", 
     RowBox[{
      RowBox[{"(", 
       RowBox[{"alt", "+", "REarth"}], ")"}], " ", 
      RowBox[{"Cos", "[", "lat", "]"}], " ", 
      RowBox[{"Cos", "[", "longitude", "]"}]}]}], "}"}], "]"}]}]], "Input",
 CellChangeTimes->{{3.5716670848138866`*^9, 3.5716670958113327`*^9}, {
  3.571667141988212*^9, 3.5716672639451847`*^9}, {3.571667509658101*^9, 
  3.571667535976925*^9}, {3.571667718053841*^9, 3.5716677234379396`*^9}, {
