Cell["For the WGS84 Parameters", "Text",
 CellChangeTimes->{{3.571686018913142*^9, 
  3.571686029245406*^9}},ExpressionUUID->"a80fea79-0930-4598-a3d0-\
8f33350c8475"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"a", "=", "6378137"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"b", "=", "6356752.31424518"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"f", "=", 
   RowBox[{"1", "/", "298.257223563"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"ecent1", "=", 
   RowBox[{"Sqrt", "[", 
    FractionBox[
     RowBox[{
      RowBox[{"a", "^", "2"}], " ", "-", " ", 
      RowBox[{"b", "^", "2"}]}], 
     RowBox[{"a", "^", "2"}]], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"ecent2", "=", 
   RowBox[{"Sqrt", "[", 
    FractionBox[
     RowBox[{
      RowBox[{"a", "^", "2"}], " ", "-", " ", 
      RowBox[{"b", "^", "2"}]}], 
     RowBox[{"b", "^", "2"}]], "]"}]}], ";"}]}], "Input",
 CellChangeTimes->{{3.5716860318243437`*^9, 
  3.571686168780551*^9}},ExpressionUUID->"0b8d8ec2-86fd-43a4-96a3-\
ea02a3f5c6a1"],

Cell["\<\
We make a transformation from the Local Tangential Plane (GPS Latitude : \
Longitude : Altitude) into the Earth-Centered/Earth-Fixed (ECEF) frame.

The transformation for each coordinate is given by:\
\>", "Text",
 CellChangeTimes->{{3.571687674202238*^9, 
  3.571687792683696*^9}},ExpressionUUID->"c527a187-b51d-4fdc-9e6b-\
35447277fcb9"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"RCurv", "[", "lat_", "]"}], ":=", 
   FractionBox["a", 
    RowBox[{"Sqrt", "[", 
     RowBox[{"1", " ", "-", " ", 
      RowBox[{
       RowBox[{"ecent1", "^", "2"}], " ", 
       RowBox[{
        RowBox[{"Sin", "[", "lat", "]"}], "^", "2"}]}]}], "]"}]]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"Xpos", "[", 
    RowBox[{"lat_", ",", "long_", ",", " ", "height_"}], "]"}], ":=", 
   RowBox[{
    RowBox[{"(", 
     RowBox[{
      RowBox[{"RCurv", "[", "lat", "]"}], "+", "height"}], ")"}], 
    RowBox[{"Cos", "[", "lat", "]"}], 
    RowBox[{"Cos", "[", "long", "]"}]}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"Ypos", "[", 
    RowBox[{"lat_", ",", "long_", ",", "height_"}], "]"}], ":=", 
   RowBox[{
    RowBox[{"(", 
     RowBox[{
      RowBox[{"RCurv", "[", "lat", "]"}], "+", "height"}], ")"}], 
    RowBox[{"Cos", "[", "lat", "]"}], 
    RowBox[{"Sin", "[", "long", "]"}]}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"Zpos", "[", 
   RowBox[{"lat_", ",", "long_", ",", "height_"}], "]"}], ":=", 
  RowBox[{
   RowBox[{"(", 
    RowBox[{
     RowBox[{
      FractionBox[
       RowBox[{"b", "^", "2"}], 
       RowBox[{"a", "^", "2"}]], " ", 
      RowBox[{"RCurv", "[", "lat", "]"}]}], "+", "height"}], ")"}], 
   RowBox[{"Sin", "[", "lat", "]"}]}]}]}], "Input",
 CellChangeTimes->{{3.5716862457419558`*^9, 3.571686456518931*^9}, {
  3.571686489708207*^9, 
  3.571686529202173*^9}},ExpressionUUID->"1953eae5-dcfc-4e28-825a-\
22c811bb707a"],

