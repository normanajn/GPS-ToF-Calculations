        SubscriptBox["R", "curv"], "(", "\[Phi]", ")"}], "+", "h"}], ")"}], 
     " ", 
     RowBox[{"cos", "(", "\[Phi]", ")"}], " ", 
     RowBox[{"cos", "(", "\[Lambda]", ")"}]}]}],
   HoldForm], TraditionalForm]], "DisplayFormula"],

