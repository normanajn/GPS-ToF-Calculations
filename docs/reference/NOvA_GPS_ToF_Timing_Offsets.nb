       FractionBox[
        RowBox[{
         SubsuperscriptBox["R", "b", "2"], " ", 
         RowBox[{
          SubscriptBox["R", "curv"], "(", "\[Phi]", ")"}]}], 
        SubsuperscriptBox["R", "a", "2"]], "+", "h"}], ")"}], " ", 
     RowBox[{"sin", "(", "\[Phi]", ")"}]}]}],
   HoldForm], TraditionalForm]], "DisplayFormula"],

Cell[TextData[{
 "Eq. 17 in the note is printed as p",
 Cell[BoxData[
  SubscriptBox["", "z"]]],
 " = R",
 Cell[BoxData[
  SubscriptBox["", "b"]]],
 Cell[BoxData[
  SuperscriptBox["", "2"]]],
 "/R",
 Cell[BoxData[
  SubscriptBox["", "a"]]],
 Cell[BoxData[
  SuperscriptBox["", "2"]]],
 " (R",
 Cell[BoxData[
  SubscriptBox["", "curv"]]],
 " + h) sin \[Theta], which scales h by (1 \[Minus] \[Epsilon]",
 Cell[BoxData[
  SubscriptBox["", "a"]]],
 Cell[BoxData[
  SuperscriptBox["", "2"]]],
 ") as well. The standard form above is what the 2013 notebook implemented \
and what produces the note's 809 606 m. The printed form is kept as ",
 StyleBox["pWGSasPrinted", "InlineCode"],
 " so its effect can be computed (\[Section]10)."
}], "Text"],

