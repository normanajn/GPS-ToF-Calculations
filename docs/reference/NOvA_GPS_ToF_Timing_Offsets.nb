Cell[CellGroupData[{

Cell["15. Follow-ups", "Section"],

Cell[CellGroupData[{

Cell["\<\
Fill in Table 3: survey the Ash River mast axis and each antenna \
\[RightArrow] FD front-face vector, and the MINOS mast \[RightArrow] ND \
vector.\
\>", "Item"],

Cell["\<\
Record an NMEA ($GPGGA and $POLYP) fix for the FNAL antennas to settle the \
datum of the 228 m altitude, and replace the 1\[DoublePrime] coordinate with \
the receiver fix.\
\>", "Item"],

Cell["\<\
Correct eqs. 7, 9, 12\[Dash]14, 17 and 19 in the note before it is filed in \
DocDB, and fill in the placeholders.\
\>", "Item"],

Cell["\<\
Measure or look up the antenna cable delays and receiver compensation \
settings at both sites.\
\>", "Item"],

Cell["\<\
Decide and document the integer-tick rounding convention used in the timing \
system configuration.\
\>", "Item"]
}, Open  ]]
}, Open  ]]
}, Open  ]]
