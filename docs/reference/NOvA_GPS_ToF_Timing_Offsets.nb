}, Open  ]],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{
    RowBox[{"2013", "-", 
     RowBox[{"notebook", " ", 
      RowBox[{"inputs", ":", " ", 
       RowBox[{"FNAL", " ", "offset", " ", "300", " ", "m"}]}]}]}], ",", " ", 
    
    RowBox[{"no", " ", "FD", " ", "offset"}], ",", " ", 
    RowBox[{"h", " ", "=", " ", 
     RowBox[{"348", " ", "m", " ", 
      RowBox[{"(", 
       RowBox[{"Ant", "-", "1"}], ")"}]}]}]}], " ", "*)"}], "\n", 
  RowBox[{
   RowBox[{
    RowBox[{"LSph2013", " ", "=", " ", 
     RowBox[{"LSph", "[", 
      RowBox[{"fnalAnt", ",", " ", 
       RowBox[{"ashAnt", "[", 
        RowBox[{"[", "1", "]"}], "]"}], ",", " ", "300", ",", " ", "0"}], 
