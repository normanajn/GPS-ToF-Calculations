Cell[CellGroupData[{

Cell["\<\
4.2 Antenna \[RightArrow] detector offsets (2014 note, \[Section]3.1 and \
Tables 2\[Dash]3)\
\>", "Subsection"],

Cell[TextData[{
 "The GPS fixes are antenna positions. Each is shifted to the ",
 StyleBox["centre of the detector front face",
  FontWeight->"Bold"],
 " (the face nearest the beam), so the delay is front-face to front-face, \
i.e. the earliest particle arrival."
}], "Text"],

Cell[CellGroupData[{

Cell[TextData[{
 StyleBox["Far Detector:",
  FontWeight->"Bold"],
 " 12 m from the antenna down to the top edge of the detector, plus 7.8 m \
down to mid-height (the FD is 15.6 m tall), for a total of 19.8 m."
}], "Item"],

Cell[TextData[{
 StyleBox["Near Detector:",
  FontWeight->"Bold"],
 " the NuMI/MINOS cavern is taken to be 105 m deep, and the antenna mount on \
the MINOS service building is 15 m above the surface, for a total of 120 m."
}], "Item"],

Cell[TextData[{
 StyleBox["Horizontal offsets:",
  FontWeight->"Bold"],
 " all Ash River entries in Table 3 are TBD. The only numeric row is \
\[OpenCurlyDoubleQuote]Fnal NDOS\[CloseCurlyDoubleQuote]: \[CapitalDelta]x, \
\[CapitalDelta]y, \[CapitalDelta]z = 2, 3, \[Minus]3 m, with the note \
\[OpenCurlyDoubleQuote]105 + 15\[CloseCurlyDoubleQuote]. Its frame and \
meaning are ambiguous, so it is not applied in the baseline. \[Section]10 \
evaluates it as a sensitivity."
}], "Item"]
}, Open  ]],

Cell["\<\
This replaces the 2013 notebook's single antenna \[RightArrow] ND offset of \
300 m. The 2013 notebook applied no FD offset.\
\>", "Text"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"dFD", " ", "=", " ", 
    RowBox[{"12", " ", "+", " ", "7.8"}]}], ";"}], "           ", 
  RowBox[{"(*", " ", 
   RowBox[{"m", ",", " ", 
    RowBox[{
     RowBox[{"Ash", " ", "River", " ", "antenna"}], " ", "->", " ", 
     RowBox[{
      RowBox[{"FD", " ", "front"}], "-", 
      RowBox[{"face", " ", "centre", " ", 
       RowBox[{"(", "vertical", ")"}]}]}]}]}], " ", "*)"}]}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"dND", " ", "=", " ", 
    RowBox[{"105", " ", "+", " ", "15"}]}], ";"}], "           ", 
  RowBox[{"(*", " ", 
   RowBox[{"m", ",", " ", 
    RowBox[{
     RowBox[{"MINOS", " ", "mast", " ", "antenna"}], " ", "->", " ", 
     RowBox[{"ND", " ", "cavern", " ", 
      RowBox[{"(", "vertical", ")"}]}]}]}], " ", "*)"}]}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"sel", " ", "=", " ", "2"}], ";"}], "                  ", 
  RowBox[{"(*", " ", 
   RowBox[{
   "Ash", " ", "River", " ", "antenna", " ", "used", " ", "for", " ", "the", 
    " ", "baseline", " ", "result", " ", 
    RowBox[{"(", 
     RowBox[{
      RowBox[{"Ant", "-", "2"}], ",", " ", 
      RowBox[{"as", " ", "in", " ", "the", " ", "2013", " ", "notebook"}]}], 
     ")"}]}], " ", "*)"}]}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"upModel", " ", "=", " ", "\"\<geodetic\>\""}], ";"}], "     ", 
  RowBox[{"(*", " ", 
   RowBox[{"\"\<geodetic\>\"", " ", 
    RowBox[{"(", 
     RowBox[{"ellipsoid", " ", "normal"}], ")"}], " ", "or", " ", 
    "\"\<radial\>\"", " ", 
    RowBox[{"(", 
     RowBox[{
      RowBox[{"sphere", " ", "tangent", " ", "plane"}], ",", " ", 
      RowBox[{
      "as", " ", "described", " ", "in", " ", "the", " ", "2014", " ", 
       "note"}]}], ")"}]}], " ", "*)"}]}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"dNDOS", " ", "=", " ", 
    RowBox[{"{", 
     RowBox[{"2", ",", " ", "3", ",", " ", 
      RowBox[{"-", "3"}]}], "}"}]}], ";"}], "       ", 
  RowBox[{"(*", " ", 
   RowBox[{"m", ",", " ", 
    RowBox[{"Table", " ", 
     RowBox[{"3", " ", "'"}], "Fnal", " ", 
     RowBox[{"NDOS", "'"}], " ", 
     RowBox[{"row", ":", " ", 
      RowBox[{"sensitivity", " ", "only"}]}]}]}], " ", "*)"}]}], "\n", 
 RowBox[{"{", 
  RowBox[{"dFD", ",", " ", "dND"}], "}"}]}], "Input",
 CellLabel->
  "In[119]:=",ExpressionUUID->"56e17a29-7c67-43d9-85a3-52534f133a36"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"19.8`", ",", "120"}], "}"}]], "Output",
 CellChangeTimes->{3.999341738575521*^9},
 CellLabel->
  "Out[124]=",ExpressionUUID->"1ce5aa44-f7b7-4e91-a2ac-b3593972b363"]
}, Open  ]]
}, Open  ]],

Cell[CellGroupData[{

Cell["4.3 Applying the offsets: tangent-plane vector \[RightArrow] ECF", \
"Subsection"],

Cell[TextData[{
 "The note takes the plane tangent to the Earth at the antenna, forms the \
antenna \[RightArrow] detector vector in that plane's local frame (east, \
north, up), and projects it onto the ECF axes. For a local offset d = (d",
 Cell[BoxData[
  SubscriptBox["", "E"]]],
 ", d",
 Cell[BoxData[
  SubscriptBox["", "N"]]],
 ", d",
 Cell[BoxData[
  SubscriptBox["", "U"]]],
 "):"
}], "Text"],

Cell[BoxData[
 FormBox[
  TagBox[
   RowBox[{
    RowBox[{"\[Delta]", " ", 
     OverscriptBox["p", "\[RightVector]"]}], "\[LongEqual]", 
    RowBox[{
     RowBox[{
      SubscriptBox["d", "E"], " ", 
      OverscriptBox["E", "^"]}], "+", 
     RowBox[{
      SubscriptBox["d", "N"], " ", 
      OverscriptBox["N", "^"]}], "+", 
     RowBox[{
      SubscriptBox["d", "U"], " ", 
      OverscriptBox["U", "^"]}]}]}],
   HoldForm], TraditionalForm]], "DisplayFormula"],

Cell[BoxData[
 FormBox[
  TagBox[
   RowBox[{
    OverscriptBox["E", "^"], "\[LongEqual]", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"-", 
       RowBox[{"sin", "(", "\[Lambda]", ")"}]}], ",", 
      RowBox[{"cos", "(", "\[Lambda]", ")"}], ",", "0"}], "}"}]}],
   HoldForm], TraditionalForm]], "DisplayFormula"],

Cell[BoxData[
 FormBox[
  TagBox[
   RowBox[{
    OverscriptBox["N", "^"], "\[LongEqual]", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{
       RowBox[{"-", 
        RowBox[{"sin", "(", "\[Phi]", ")"}]}], " ", 
       RowBox[{"cos", "(", "\[Lambda]", ")"}]}], ",", 
      RowBox[{
       RowBox[{"-", 
        RowBox[{"sin", "(", "\[Phi]", ")"}]}], " ", 
       RowBox[{"sin", "(", "\[Lambda]", ")"}]}], ",", 
      RowBox[{"cos", "(", "\[Phi]", ")"}]}], "}"}]}],
   HoldForm], TraditionalForm]], "DisplayFormula"],

Cell[BoxData[
 FormBox[
  TagBox[
   RowBox[{
    OverscriptBox["U", "^"], "\[LongEqual]", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{
       RowBox[{"cos", "(", "\[Phi]", ")"}], " ", 
       RowBox[{"cos", "(", "\[Lambda]", ")"}]}], ",", 
      RowBox[{
       RowBox[{"cos", "(", "\[Phi]", ")"}], " ", 
       RowBox[{"sin", "(", "\[Lambda]", ")"}]}], ",", 
      RowBox[{"sin", "(", "\[Phi]", ")"}]}], "}"}]}],
   HoldForm], TraditionalForm]], "DisplayFormula"],

Cell[TextData[{
 "Here \[Phi] is the geodetic latitude and \[Lambda] the longitude (standard \
ECEF axes). With the geodetic normal, a pure vertical offset is the same as \
replacing h with h \[Minus] d",
 Cell[BoxData[
  SubscriptBox["", "U"]]],
 ". The note specifies a plane tangent to a ",
 StyleBox["sphere",
  FontWeight->"Bold"],
 ", i.e. U\:0302 = p/|p|. That differs from the geodetic normal by the \
geodetic \[Minus] geocentric latitude difference (\[TildeTilde]0.19\[Degree] \
at these sites). Both are implemented, and the difference is evaluated in \
\[Section]10. The flight path is then (eqs. 6 and 18):"
}], "Text"],

Cell[BoxData[
 FormBox[
  TagBox[
   RowBox[{"\[CapitalDelta]L", "\[LongEqual]", 
    TemplateBox[{RowBox[{
        RowBox[{"(", 
          RowBox[{
            SubscriptBox[
             OverscriptBox["p", "\[RightVector]"], "ND"], "-", 
            SubscriptBox[
             RowBox[{"\[Delta]", " ", 
               OverscriptBox["p", "\[RightVector]"]}], "ND"]}], ")"}], "-", 
        RowBox[{"(", 
          RowBox[{
            SubscriptBox[
             OverscriptBox["p", "\[RightVector]"], "FD"], "-", 
            SubscriptBox[
             RowBox[{"\[Delta]", " ", 
               OverscriptBox["p", "\[RightVector]"]}], "FD"]}], ")"}]}]},
     "Norm"]}],
   HoldForm], TraditionalForm]], "DisplayFormula"],

Cell[BoxData[
 FormBox[
  TagBox[
   RowBox[{"\[CapitalDelta]t", "\[LongEqual]", 
    FractionBox["\[CapitalDelta]L", "c"]}],
   HoldForm], TraditionalForm]], "DisplayFormula"]
}, Open  ]]
}, Open  ]],

Cell[CellGroupData[{

Cell["5. Model 1: spherical Earth (2014 note \[Section]3.1)", "Section"],

Cell[TextData[{
 "The Earth is a sphere of radius R",
 Cell[BoxData[
  SubscriptBox["", "E"]]],
 " = 6 378 137 m. The note calls this the \[OpenCurlyDoubleQuote]mean \
equatorial radius\[CloseCurlyDoubleQuote]; it is the WGS84 equatorial radius, \
while the mean Earth radius is 6 371.0 km. The note uses \[Theta] for \
longitude and \[Phi] for latitude in this section (eqs. 3\[Dash]5):"
}], "Text"],

Cell[BoxData[
 FormBox[
  TagBox[
   RowBox[{
    SubscriptBox["p", "x"], "\[LongEqual]", 
    RowBox[{
     RowBox[{"(", 
      RowBox[{
       SubscriptBox["R", "E"], "+", "A"}], ")"}], " ", 
     RowBox[{"sin", "(", "\[Theta]", ")"}], " ", 
     RowBox[{"cos", "(", "\[Phi]", ")"}]}]}],
   HoldForm], TraditionalForm]], "DisplayFormula"],

Cell[BoxData[
 FormBox[
  TagBox[
   RowBox[{
    SubscriptBox["p", "y"], "\[LongEqual]", 
    RowBox[{
     RowBox[{"(", 
      RowBox[{
       SubscriptBox["R", "E"], "+", "A"}], ")"}], " ", 
     RowBox[{"cos", "(", "\[Theta]", ")"}], " ", 
     RowBox[{"cos", "(", "\[Phi]", ")"}]}]}],
   HoldForm], TraditionalForm]], "DisplayFormula"],

Cell[BoxData[
 FormBox[
  TagBox[
   RowBox[{
    SubscriptBox["p", "z"], "\[LongEqual]", 
    RowBox[{
     RowBox[{"(", 
      RowBox[{
       SubscriptBox["R", "E"], "+", "A"}], ")"}], " ", 
     RowBox[{"sin", "(", "\[Phi]", ")"}]}]}],
   HoldForm], TraditionalForm]], "DisplayFormula"],

Cell["\<\
This frame swaps the standard x and y axes (a reflection), which leaves \
distances unchanged. On the sphere, the tangent-plane normal is radial, so a \
vertical offset d is the same as using A \[Minus] d. \[Section]3.1 of the \
note says the MSL altitude is used here, but Table 2 lists ellipsoidal \
heights (see \[Section]3.2). The table values are used, as the note's numbers \
do.\
\>", "Text"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"RE", " ", "=", " ", "6378137"}], ";"}], "\n", 
 RowBox[{
  RowBox[{"pSph", "[", 
   RowBox[{"s_Association", ",", " ", 
    RowBox[{"d_:", " ", "0"}]}], "]"}], " ", ":=", " ", 
  RowBox[{
   RowBox[{"(", 
    RowBox[{"RE", " ", "+", " ", 
     RowBox[{"s", "[", "\"\<h\>\"", "]"}], " ", "-", " ", "d"}], ")"}], " ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{
      RowBox[{"Sin", "[", 
       RowBox[{"s", "[", "\"\<lon\>\"", "]"}], "]"}], " ", 
      RowBox[{"Cos", "[", 
       RowBox[{"s", "[", "\"\<lat\>\"", "]"}], "]"}]}], ",", " ", 
     RowBox[{
      RowBox[{"Cos", "[", 
       RowBox[{"s", "[", "\"\<lon\>\"", "]"}], "]"}], " ", 
      RowBox[{"Cos", "[", 
       RowBox[{"s", "[", "\"\<lat\>\"", "]"}], "]"}]}], ",", " ", 
     RowBox[{"Sin", "[", 
      RowBox[{"s", "[", "\"\<lat\>\"", "]"}], "]"}]}], "}"}]}]}], "\n", 
 RowBox[{
  RowBox[{"LSph", "[", 
   RowBox[{"fnal_", ",", " ", "ash_", ",", " ", "dF_", ",", " ", "dA_"}], 
   "]"}], " ", ":=", " ", 
  RowBox[{"Norm", "[", 
   RowBox[{
    RowBox[{"pSph", "[", 
     RowBox[{"fnal", ",", " ", "dF"}], "]"}], " ", "-", " ", 
    RowBox[{"pSph", "[", 
     RowBox[{"ash", ",", " ", "dA"}], "]"}]}], "]"}]}]}], "Input",
 CellLabel->
  "In[125]:=",ExpressionUUID->"cc9b35da-0f8f-4ce9-9bd5-5fd5fe71e0a7"],

Cell[BoxData[
 TemplateBox[{
  "SetDelayed","write",
   "\"Tag \\!\\(\\*RowBox[{\\\"Real\\\"}]\\) in \
\\!\\(\\*RowBox[{\\\"810429.1726392908`\\\", \\\"[\\\", \
RowBox[{\\\"fnal_\\\", \\\",\\\", \\\"ash_\\\", \\\",\\\", \\\"dF_\\\", \\\",\
\\\", \\\"dA_\\\"}], \\\"]\\\"}]\\) is Protected.\"",2,127,1,
   21998582534612368343,"Local"},
  "MessageTemplate"]], "Message", "MSG",
