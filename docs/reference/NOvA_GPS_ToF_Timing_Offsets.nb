      RowBox[{"eq", ".", " ", "11"}], ")"}]}]}], " ", "*)"}]}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"epsA", " ", "=", " ", 
    RowBox[{
     RowBox[{"Sqrt", "[", 
      RowBox[{
       RowBox[{"Ra", "^", "2"}], " ", "-", " ", 
       RowBox[{"Rb", "^", "2"}]}], "]"}], "/", "Ra"}]}], ";"}], "  ", 
  RowBox[{"(*", " ", 
   RowBox[{"first", " ", "eccentricity", " ", 
    RowBox[{"(", 
     RowBox[{
      RowBox[{"eq", ".", " ", "12"}], ",", " ", "corrected"}], ")"}]}], " ", 
   "*)"}]}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"epsB", " ", "=", " ", 
    RowBox[{
     RowBox[{"Sqrt", "[", 
      RowBox[{
       RowBox[{"Ra", "^", "2"}], " ", "-", " ", 
