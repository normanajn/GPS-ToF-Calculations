Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"Ra", " ", "=", " ", "6378137"}], ";"}], "                ", 
  RowBox[{"(*", " ", 
   RowBox[{
    RowBox[{"semi", "-", 
     RowBox[{"major", " ", "axis"}]}], ",", " ", 
    RowBox[{"m", " ", 
     RowBox[{"(", 
      RowBox[{"eq", ".", " ", "10"}], ")"}]}]}], " ", "*)"}]}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"Rb", " ", "=", " ", "6356752.31424518"}], ";"}], "       ", 
  RowBox[{"(*", " ", 
   RowBox[{
    RowBox[{"semi", "-", 
     RowBox[{"minor", " ", "axis"}]}], ",", " ", 
    RowBox[{"m", " ", 
