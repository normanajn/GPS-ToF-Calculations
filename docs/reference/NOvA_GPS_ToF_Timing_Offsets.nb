Cell[CellGroupData[{

Cell["3.2 Decoding $GPGGA (2014 note, Table 1)", "Subsection"],

Cell[TextData[{
 "Latitude and longitude are ddmm.mmmmmm and dddmm.mmmmmm, with the \
hemisphere in the following field. The ",
 StyleBox["$GPGGA", "InlineCode"],
 " altitude is ",
 StyleBox["above mean sea level",
  FontWeight->"Bold"],
 " (orthometric, H). The next numeric field is the geoid separation N",
 Cell[BoxData[
  SubscriptBox["", "g"]]],
 " (height of the geoid above the WGS84 ellipsoid). The ellipsoidal height \
needed by the WGS84 transform is:"
}], "Text"],

Cell[BoxData[
 FormBox[
  TagBox[
   RowBox[{"h", "\[LongEqual]", 
    RowBox[{"H", "+", 
     SubscriptBox["N", "g"]}]}],
   HoldForm], TraditionalForm]], "DisplayFormula"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"gga", " ", "=", " ", 
   RowBox[{"StringSplit", "[", 
    RowBox[{
     RowBox[{"nmea", "[", 
      RowBox[{"[", "3", "]"}], "]"}], ",", " ", "\"\<,\>\"", ",", " ", 
     "All"}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"ddmmToDeg", "[", 
    RowBox[{"str_String", ",", " ", "hemi_String"}], "]"}], " ", ":=", " ", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"v", " ", "=", " ", 
        RowBox[{"ToExpression", "[", "str", "]"}]}], ",", " ", "d"}], "}"}], 
     ",", "\n", "   ", 
     RowBox[{
      RowBox[{"d", " ", "=", " ", 
       RowBox[{"Floor", "[", 
        RowBox[{"v", "/", "100"}], "]"}]}], ";", " ", 
      RowBox[{
       RowBox[{"If", "[", 
        RowBox[{
         RowBox[{"MemberQ", "[", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{"\"\<S\>\"", ",", " ", "\"\<W\>\""}], "}"}], ",", " ", 
           "hemi"}], "]"}], ",", " ", 
         RowBox[{"-", "1"}], ",", " ", "1"}], "]"}], " ", 
       RowBox[{"(", 
        RowBox[{"d", " ", "+", " ", 
         RowBox[{
          RowBox[{"(", 
           RowBox[{"v", " ", "-", " ", 
            RowBox[{"100", " ", "d"}]}], ")"}], "/", "60"}]}], ")"}]}]}]}], 
    "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"ggaFix", " ", "=", " ", 
   RowBox[{"<|", 
    RowBox[{
     RowBox[{"\"\<UTC\>\"", " ", "->", " ", 
      RowBox[{"gga", "[", 
       RowBox[{"[", "2", "]"}], "]"}]}], ",", " ", 
     RowBox[{"\"\<lat (deg)\>\"", " ", "->", " ", 
      RowBox[{"ddmmToDeg", "[", 
       RowBox[{
        RowBox[{"gga", "[", 
         RowBox[{"[", "3", "]"}], "]"}], ",", " ", 
        RowBox[{"gga", "[", 
         RowBox[{"[", "4", "]"}], "]"}]}], "]"}]}], ",", " ", 
     RowBox[{"\"\<lon (deg)\>\"", " ", "->", " ", 
      RowBox[{"ddmmToDeg", "[", 
       RowBox[{
        RowBox[{"gga", "[", 
         RowBox[{"[", "5", "]"}], "]"}], ",", " ", 
        RowBox[{"gga", "[", 
         RowBox[{"[", "6", "]"}], "]"}]}], "]"}]}], ",", "\n", "   ", 
     RowBox[{"\"\<fix quality\>\"", " ", "->", " ", 
      RowBox[{"ToExpression", "[", 
       RowBox[{"gga", "[", 
        RowBox[{"[", "7", "]"}], "]"}], "]"}]}], ",", " ", 
     RowBox[{"\"\<satellites\>\"", " ", "->", " ", 
      RowBox[{"ToExpression", "[", 
       RowBox[{"gga", "[", 
        RowBox[{"[", "8", "]"}], "]"}], "]"}]}], ",", " ", 
     RowBox[{"\"\<HDOP\>\"", " ", "->", " ", 
      RowBox[{"ToExpression", "[", 
       RowBox[{"gga", "[", 
        RowBox[{"[", "9", "]"}], "]"}], "]"}]}], ",", "\n", "   ", 
     RowBox[{"\"\<H, MSL altitude (m)\>\"", " ", "->", " ", 
      RowBox[{"ToExpression", "[", 
       RowBox[{"gga", "[", 
        RowBox[{"[", "10", "]"}], "]"}], "]"}]}], ",", " ", 
     RowBox[{"\"\<Ng, geoid separation (m)\>\"", " ", "->", " ", 
      RowBox[{"ToExpression", "[", 
       RowBox[{"gga", "[", 
        RowBox[{"[", "12", "]"}], "]"}], "]"}]}]}], "|>"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"ggaFix", "[", "\"\<h = H + Ng, ellipsoidal (m)\>\"", "]"}], " ", 
   "=", " ", 
   RowBox[{
    RowBox[{"ggaFix", "[", "\"\<H, MSL altitude (m)\>\"", "]"}], " ", "+", 
    " ", 
    RowBox[{"ggaFix", "[", "\"\<Ng, geoid separation (m)\>\"", "]"}]}]}], 
  ";"}], "\n", 
 RowBox[{"Grid", "[", 
  RowBox[{
   RowBox[{"List", " ", "@@@", " ", 
    RowBox[{"Normal", "[", "ggaFix", "]"}]}], ",", " ", 
   RowBox[{"Frame", " ", "->", " ", "All"}], ",", " ", 
   RowBox[{"Alignment", " ", "->", " ", "Left"}]}], "]"}]}], "Input",
 CellLabel->
  "In[111]:=",ExpressionUUID->"fd2b1859-158e-424b-81f8-d4c172623250"],

