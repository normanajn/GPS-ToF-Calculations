Cell[CellGroupData[{

Cell["10. Geometry, sensitivities and neglected effects", "Section"],

Cell[CellGroupData[{

Cell["10.1 Chord geometry", "Subsection"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"pND", " ", "=", " ", 
   RowBox[{"detWGS", "[", 
    RowBox[{"fnalAnt", ",", " ", 
     RowBox[{"{", 
      RowBox[{"0", ",", " ", "0", ",", " ", "dND"}], "}"}]}], "]"}]}], ";", 
  " ", 
  RowBox[{"pFD", " ", "=", " ", 
   RowBox[{"detWGS", "[", 
    RowBox[{
     RowBox[{"ashAnt", "[", 
      RowBox[{"[", "sel", "]"}], "]"}], ",", " ", 
     RowBox[{"{", 
      RowBox[{"0", ",", " ", "0", ",", " ", "dFD"}], "}"}]}], "]"}]}], 
  ";"}], "\n", 
 RowBox[{
  RowBox[{"u", " ", "=", " ", 
   RowBox[{
    RowBox[{"(", 
     RowBox[{"pFD", " ", "-", " ", "pND"}], ")"}], "/", "L"}]}], 
  ";"}], "\n", 
 RowBox[{
  RowBox[{"gamma", " ", "=", " ", 
   RowBox[{"VectorAngle", "[", 
    RowBox[{"pND", ",", " ", "pFD"}], "]"}]}], ";", " ", 
  RowBox[{"Rm", " ", "=", " ", 
   RowBox[{
    RowBox[{"(", 
     RowBox[{
      RowBox[{"Norm", "[", "pND", "]"}], " ", "+", " ", 
      RowBox[{"Norm", "[", "pFD", "]"}]}], ")"}], "/", "2"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"dip", " ", "=", " ", 
   RowBox[{"ArcSin", "[", 
    RowBox[{"-", 
     RowBox[{"u", " ", ".", " ", 
      RowBox[{
       RowBox[{"enu", "[", "fnalAnt", "]"}], "[", 
       RowBox[{"[", "3", "]"}], "]"}]}]}], "]"}]}], ";", " ", 
  RowBox[{"rise", " ", "=", " ", 
   RowBox[{"ArcSin", "[", 
    RowBox[{"u", " ", ".", " ", 
     RowBox[{
      RowBox[{"enu", "[", 
       RowBox[{"ashAnt", "[", 
        RowBox[{"[", "sel", "]"}], "]"}], "]"}], "[", 
      RowBox[{"[", "3", "]"}], "]"}]}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"azim", " ", "=", " ", 
   RowBox[{"Mod", "[", 
    RowBox[{
     RowBox[{
      RowBox[{"ArcTan", "[", 
       RowBox[{
        RowBox[{"u", " ", ".", " ", 
         RowBox[{
          RowBox[{"enu", "[", "fnalAnt", "]"}], "[", 
          RowBox[{"[", "2", "]"}], "]"}]}], ",", " ", 
        RowBox[{"u", " ", ".", " ", 
         RowBox[{
          RowBox[{"enu", "[", "fnalAnt", "]"}], "[", 
          RowBox[{"[", "1", "]"}], "]"}]}]}], "]"}], "/", "Degree"}], ",", 
     " ", "360"}], "]"}]}], ";"}], "\n", 
 RowBox[{"Grid", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"\"\<central angle (deg)\>\"", ",", " ", 
       RowBox[{"gamma", "/", "Degree"}]}], "}"}], ",", " ", 
     RowBox[{"{", 
      RowBox[{"\"\<surface arc at mean radius (m)\>\"", ",", " ", 
       RowBox[{"Rm", " ", "gamma"}]}], "}"}], ",", " ", 
     RowBox[{"{", 
      RowBox[{"\"\<arc - chord (m)\>\"", ",", " ", 
       RowBox[{
        RowBox[{"Rm", " ", "gamma"}], " ", "-", " ", "L"}]}], "}"}], ",", 
     "\n", "  ", 
     RowBox[{"{", 
      RowBox[{"\"\<sagitta (m)\>\"", ",", " ", 
       RowBox[{"Rm", " ", 
        RowBox[{"(", 
         RowBox[{"1", " ", "-", " ", 
          RowBox[{"Cos", "[", 
           RowBox[{"gamma", "/", "2"}], "]"}]}], ")"}]}]}], "}"}], ",", " ", 
     RowBox[{"{", 
      RowBox[{"\"\<dip below horizontal at ND (deg)\>\"", ",", " ", 
       RowBox[{"dip", "/", "Degree"}]}], "}"}], ",", " ", 
     RowBox[{"{", 
      RowBox[{"\"\<rise above horizontal at FD (deg)\>\"", ",", " ", 
       RowBox[{"rise", "/", "Degree"}]}], "}"}], ",", "\n", "  ", 
     RowBox[{"{", 
      RowBox[{"\"\<azimuth at FNAL (deg from N)\>\"", ",", " ", "azim"}], 
      "}"}]}], "}"}], ",", " ", 
   RowBox[{"Frame", " ", "->", " ", "All"}], ",", " ", 
   RowBox[{"Alignment", " ", "->", " ", "Left"}]}], "]"}]}], "Input",
