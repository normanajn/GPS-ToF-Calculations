       ",", " ", 
       RowBox[{"\"\<h\>\"", " ", "->", " ", "348.638"}]}], "|>"}], ",", "\n", 
     "   ", 
     RowBox[{"<|", 
      RowBox[{
       RowBox[{"\"\<name\>\"", " ", "->", " ", "\"\<Ash River Ant-3\>\""}], 
       ",", " ", 
       RowBox[{"\"\<lat\>\"", " ", "->", " ", 
        RowBox[{"LC", "[", 
         RowBox[{"48", ",", " ", "22.716416", ",", " ", "0"}], "]"}]}], ",", 
       " ", 
       RowBox[{"\"\<lon\>\"", " ", "->", " ", 
        RowBox[{"-", 
         RowBox[{"LC", "[", 
          RowBox[{"92", ",", " ", "49.877639", ",", " ", "0"}], "]"}]}]}], 
       ",", " ", 
       RowBox[{"\"\<h\>\"", " ", "->", " ", "350.346"}]}], "|>"}]}], "}"}]}], 
  ";"}], "\n", 
 RowBox[{
  RowBox[{"fnalAnt", " ", "=", " ", 
   RowBox[{"<|", 
    RowBox[{
     RowBox[{
     "\"\<name\>\"", " ", "->", " ", "\"\<FNAL MINOS Surface Bldg mast\>\""}],
      ",", " ", 
