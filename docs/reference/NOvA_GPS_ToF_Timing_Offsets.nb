Cell[CellGroupData[{

Cell["10.2 Sensitivity table", "Subsection"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"ash", " ", "=", " ", 
   RowBox[{"ashAnt", "[", 
    RowBox[{"[", "sel", "]"}], "]"}]}], ";", " ", 
  RowBox[{"arcsec", " ", "=", " ", 
   RowBox[{"Pi", "/", 
    RowBox[{"(", 
     RowBox[{"180", "*", "3600"}], ")"}]}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"sens", " ", "=", " ", 
   RowBox[{"{", "\n", "   ", 
    RowBox[{
     RowBox[{"sensRow", "[", 
      RowBox[{"\"\<FNAL height +1 m\>\"", ",", " ", 
       RowBox[{
        RowBox[{"Lvar", "[", 
         RowBox[{
          RowBox[{"<|", 
           RowBox[{"fnalAnt", ",", " ", 
            RowBox[{"\"\<h\>\"", " ", "->", " ", 
             RowBox[{
              RowBox[{"fnalAnt", "[", "\"\<h\>\"", "]"}], " ", "+", " ", 
              "1"}]}]}], "|>"}], ",", " ", "ash"}], "]"}], " ", "-", " ", 
        "L"}]}], "]"}], ",", "\n", "   ", 
     RowBox[{"sensRow", "[", 
      RowBox[{"\"\<FD height +1 m\>\"", ",", " ", 
       RowBox[{
        RowBox[{"Lvar", "[", 
         RowBox[{"fnalAnt", ",", " ", 
          RowBox[{"<|", 
           RowBox[{"ash", ",", " ", 
            RowBox[{"\"\<h\>\"", " ", "->", " ", 
             RowBox[{
              RowBox[{"ash", "[", "\"\<h\>\"", "]"}], " ", "+", " ", 
              "1"}]}]}], "|>"}]}], "]"}], " ", "-", " ", "L"}]}], "]"}], ",", 
     "\n", "   ", 
