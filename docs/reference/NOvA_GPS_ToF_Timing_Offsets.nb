Cell[TextData[{
 StyleBox["FNAL coordinate precision:",
  FontWeight->"Bold"],
 " the FNAL position is given to 1\[DoublePrime] (about 31 m N\[Dash]S and 23 \
m E\[Dash]W), while Ash River is given to 10",
 Cell[BoxData[
  SuperscriptBox["", 
   RowBox[{"\[Minus]", "6"}]]]],
 "\[Prime] (2 mm). \[PlusMinus]0.5\[DoublePrime] rounding gives the \
worst-case and RMS errors computed below. This is the dominant precision \
limit."
}], "Item"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"maxErr", " ", "=", " ", 
   RowBox[{"0.5", " ", 
    RowBox[{"(", 
     RowBox[{
      RowBox[{"Abs", "[", 
       RowBox[{"sens", "[", 
        RowBox[{"[", 
         RowBox[{"3", ",", " ", "2"}], "]"}], "]"}], "]"}], " ", "+", " ", 
      RowBox[{"Abs", "[", 
       RowBox[{"sens", "[", 
        RowBox[{"[", 
         RowBox[{"4", ",", " ", "2"}], "]"}], "]"}], "]"}]}], ")"}]}]}], ";", 
  " ", 
  RowBox[{"rmsErr", " ", "=", " ", 
   RowBox[{
    RowBox[{"Norm", "[", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"sens", "[", 
        RowBox[{"[", 
         RowBox[{"3", ",", " ", "2"}], "]"}], "]"}], ",", " ", 
       RowBox[{"sens", "[", 
        RowBox[{"[", 
         RowBox[{"4", ",", " ", "2"}], "]"}], "]"}]}], "}"}], "]"}], "/", 
    RowBox[{"Sqrt", "[", "12.", "]"}]}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"{", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"\"\<worst case\>\"", ",", " ", "maxErr", ",", " ", 
      RowBox[{"toNs", "[", "maxErr", "]"}], ",", " ", 
      RowBox[{"toTicks", "[", "maxErr", "]"}]}], "}"}], ",", " ", 
    RowBox[{"{", 
     RowBox[{"\"\<RMS\>\"", ",", " ", "rmsErr", ",", " ", 
      RowBox[{"toNs", "[", "rmsErr", "]"}], ",", " ", 
      RowBox[{"toTicks", "[", "rmsErr", "]"}]}], "}"}]}], "}"}], " ", "//", 
  " ", 
  RowBox[{
   RowBox[{"Grid", "[", 
    RowBox[{"#", ",", " ", 
     RowBox[{"Frame", " ", "->", " ", "All"}]}], "]"}], " ", 
   "&"}]}]}], "Input",
 CellLabel->
  "In[178]:=",ExpressionUUID->"fc06a1e1-51a3-4f2f-ae7a-e0158720b94d"],

Cell[BoxData[
 TagBox[GridBox[{
    {"\<\"worst case\"\>", "18.797560319013428`", "62.701911997444`", 
     "4.012922367836416`"},
    {"\<\"RMS\"\>", "8.540040529573792`", "28.486508922028293`", 
     "1.8231365710098106`"}
   },
