       RowBox[{"41", ",", " ", "50", ",", " ", "23"}], "]"}]}], ",", " ", 
     RowBox[{"\"\<lon\>\"", " ", "->", " ", 
      RowBox[{"-", 
       RowBox[{"LC", "[", 
        RowBox[{"88", ",", " ", "16", ",", " ", "13"}], "]"}]}]}], ",", " ", 
     RowBox[{"\"\<h\>\"", " ", "->", " ", "228."}]}], "|>"}]}], ";"}], "\n", 
 RowBox[{"Grid", "[", 
  RowBox[{
   RowBox[{"Prepend", "[", 
    RowBox[{
     RowBox[{
      RowBox[{
       RowBox[{"{", 
        RowBox[{"#name", ",", " ", 
         RowBox[{"#lat", "/", "Degree"}], ",", " ", 
         RowBox[{"#lon", "/", "Degree"}], ",", " ", "#h"}], "}"}], " ", "&"}],
       " ", "/@", " ", 
