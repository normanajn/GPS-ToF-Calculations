Cell[CellGroupData[{

Cell["3. GPS antenna positions from the TDU NMEA stream", "Section"],

Cell[TextData[{
 "Detector positions come from the GPS receivers in the TDU (timing \
distribution unit) masters. At Ash River, three receivers in the FD computing \
center (relay rack 3) are connected to three antennas on a single four-mount \
mast on the building roof, through a common ~100 ft cable run. At Fermilab, \
the MINOS Surface Building has two antennas on a single two-mount mast. The \
NOvA surface building (NDOS) has one antenna and one cable. The receiver NMEA \
output was read over the TDU USB-serial port with GNU ",
 StyleBox["screen", "InlineCode"],
 " at 38400 baud. The NMEA block repeats every 5 s."
}], "Text"],

Cell[CellGroupData[{

Cell["3.1 NMEA block recorded at Ash River (2014 note, \[Section]2.2)", \
"Subsection"],

Cell[TextData[{
 "The ",
 StyleBox["$POLYT", "InlineCode"],
 ", ",
 StyleBox["$POLYP", "InlineCode"],
 " and ",
 StyleBox["$POLYS", "InlineCode"],
 " lines run past the right margin of the note and are truncated, so their \
checksums cannot be tested. The complete sentences are checked below with the \
NMEA 0183 checksum: the XOR of all characters between ",
 StyleBox["$", "InlineCode"],
 " and ",
 StyleBox["*", "InlineCode"],
 ", in hexadecimal."
}], "Text"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"nmea", " ", "=", " ", 
   RowBox[{"{", "\n", "   ", 
    RowBox[{
    "\"\<$GPGLL,4822.716417,N,09249.877638,W,210341.002,A,A*41\>\"", ",", 
     "\n", "   ", 
     "\"\<$GPRMC,210341.002,A,4822.716417,N,09249.877638,W,0.000,0.00,070313,,\
,A*40\>\"", ",", "\n", "   ", 
     "\"\<$GPGGA,210341.002,4822.716417,N,09249.877638,W,1,12,0.71,382.823,M,-\
32.462,M,,*5D\>\"", ",", "\n", "   ", 
     "\"\<$GPGSA,A,3,31,11,14,25,01,20,23,30,22,16,12,32,1.20,0.71,0.96*0C\>\"\
", ",", "\n", "   ", 
     "\"\<$GPGSV,3,1,12,31,88,142,48,11,02,241,38,14,35,092,45,25,31,053,44*\
75\>\"", ",", "\n", "   ", 
     "\"\<$GPGSV,3,2,12,01,20,256,44,20,40,300,45,23,11,285,42,30,27,171,44*\
74\>\"", ",", "\n", "   ", 
     "\"\<$GPGSV,3,3,12,22,07,152,42,16,02,182,37,12,07,029,40,32,64,275,47*\
7C\>\"", ",", "\n", "   ", 
     "\"\<$POLYI,JN,18,EXT,HPOS,VPOS,INT,TSYNC,*19\>\""}], "}"}]}], 
  ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"nmeaChecksum", "[", "s_String", "]"}], " ", ":=", " ", 
   RowBox[{"ToUpperCase", "[", 
    RowBox[{"IntegerString", "[", 
     RowBox[{
      RowBox[{"BitXor", " ", "@@", " ", 
       RowBox[{"ToCharacterCode", "[", 
        RowBox[{"StringTake", "[", 
         RowBox[{"s", ",", " ", 
          RowBox[{"{", 
           RowBox[{"2", ",", " ", 
            RowBox[{
             RowBox[{"First", "[", 
              RowBox[{"First", "[", 
               RowBox[{"StringPosition", "[", 
                RowBox[{"s", ",", " ", "\"\<*\>\""}], "]"}], "]"}], "]"}], 
             " ", "-", " ", "1"}]}], "}"}]}], "]"}], "]"}]}], ",", " ", "16", 
      ",", " ", "2"}], "]"}], "]"}]}], ";"}], "\n", 
 RowBox[{"Grid", "[", 
  RowBox[{
   RowBox[{"Prepend", "[", 
    RowBox[{
     RowBox[{
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{"StringTake", "[", 
          RowBox[{"#", ",", " ", "6"}], "]"}], ",", " ", 
         RowBox[{"StringTake", "[", 
          RowBox[{"#", ",", " ", 
           RowBox[{"-", "2"}]}], "]"}], ",", " ", 
         RowBox[{"nmeaChecksum", "[", "#", "]"}], ",", " ", 
         RowBox[{"If", "[", 
          RowBox[{
           RowBox[{
            RowBox[{"nmeaChecksum", "[", "#", "]"}], " ", "==", " ", 
            RowBox[{"StringTake", "[", 
             RowBox[{"#", ",", " ", 
              RowBox[{"-", "2"}]}], "]"}]}], ",", " ", 
           RowBox[{"Style", "[", 
            RowBox[{"\"\<valid\>\"", ",", " ", 
             RowBox[{"Darker", "[", "Green", "]"}]}], "]"}], ",", " ", 
           RowBox[{"Style", "[", 
            RowBox[{"\"\<INVALID\>\"", ",", " ", "Red"}], "]"}]}], "]"}]}], 
        "}"}], " ", "&"}], " ", "/@", " ", "nmea"}], ",", "\n", "   ", 
     RowBox[{"{", 
      RowBox[{
      "\"\<sentence\>\"", ",", " ", "\"\<stated\>\"", ",", " ", 
