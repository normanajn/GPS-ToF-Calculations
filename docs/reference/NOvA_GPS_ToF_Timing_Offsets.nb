Cell[TextData[{
 "The transform from geodetic coordinates (\[Phi] = latitude, \[Lambda] = \
longitude, h = ellipsoidal height) to ECF (eqs. 14\[Dash]17) is below. In \
this section the note uses \[Theta] for latitude. Eq. 14's numerator \
\[OpenCurlyDoubleQuote]a\[CloseCurlyDoubleQuote] is R",
 Cell[BoxData[
  SubscriptBox["", "a"]]],
 ", and sin \[Theta]",
 Cell[BoxData[
  SuperscriptBox["", "2"]]],
 " means sin",
 Cell[BoxData[
  SuperscriptBox["", "2"]]],
 "\[Theta]."
}], "Text"],

Cell[BoxData[
 FormBox[
  TagBox[
   RowBox[{
    RowBox[{
     SubscriptBox["R", "curv"], "(", "\[Phi]", ")"}], "\[LongEqual]", 
    FractionBox[
     SubscriptBox["R", "a"], 
     SqrtBox[
      RowBox[{"1", "-", 
       RowBox[{
        SubsuperscriptBox["\[Epsilon]", "a", "2"], " ", 
        RowBox[{
         SuperscriptBox["sin", "2"], "(", "\[Phi]", ")"}]}]}]]]}],
   HoldForm], TraditionalForm]], "DisplayFormula"],

